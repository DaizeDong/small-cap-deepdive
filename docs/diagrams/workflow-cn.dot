// Public workflow documentation. Render with: python docs/diagrams/render.py
digraph workflow {
  graph [rankdir=LR, bgcolor="white", fontname="Microsoft YaHei", pad=0.18,
         nodesep=0.35, ranksep=0.30, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
        fontcolor="#0f172a", penwidth=1.6, margin="0.15,0.12"];
  edge [fontname="Microsoft YaHei", fontsize=11, color="#64748b", fontcolor="#475569",
        penwidth=1.4, arrowsize=0.7];

  candidates [label=<<b>候选入口</b><br/><font point-size="12">theme / ticker / events</font>>,
              fillcolor="#eef2ff", color="#6366f1"];
  screen [label=<<b>cheap_pass</b><br/><font point-size="12">rejected?</font>>,
          fillcolor="#fef9c3", color="#ca8a04"];
  theme [label=<<b>主题专用检查</b><br/><font point-size="12">SIC 分层 → 契合度</font>>,
         fillcolor="#fef9c3", color="#ca8a04"];
  excluded [label=<<b>淘汰记录</b><br/><font point-size="12">保留原因与范围</font>>,
            fillcolor="#fff1f2", color="#e11d48"];
  research [label=<<b>数据与估值</b><br/><font point-size="12">反方检验</font>>,
            fillcolor="#f1f5f9", color="#475569"];
  reports [label=<<b>公司报告</b><br/><font point-size="12">可直接交付</font>>,
           fillcolor="#e0f2fe", color="#0284c7"];
  existing [label=<<b>既有评级报告</b><br/><font point-size="12">rank 输入</font>>,
            fillcolor="#eef2ff", color="#6366f1"];
  ranking [label=<<b>按需排序</b><br/><font point-size="12">覆盖范围与缺口</font>>,
           fillcolor="#e0f2fe", color="#0284c7"];

  candidates -> screen;
  screen -> theme [label="false:\ntheme", color="#ca8a04"];
  screen -> research [label="false: ticker / events", color="#475569"];
  screen -> excluded [label="true", color="#e11d48", fontcolor="#be123c"];
  theme -> research [label="契合者保留", color="#16a34a"];
  theme -> excluded [label="misrecall", color="#e11d48", fontcolor="#be123c"];
  research -> reports;
  reports -> ranking [color="#0284c7"];
  existing -> ranking [color="#6366f1"];
  excluded -> ranking [style=dashed, color="#e11d48", constraint=false];

  { rank=same; theme; excluded; }
  { rank=same; research; existing; }
  { rank=same; reports; ranking; }
}
